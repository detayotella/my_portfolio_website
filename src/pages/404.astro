---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<Base title="404 · Page not found">
  <SiteHeader />
  <main id="main" class="mx-auto flex w-full max-w-5xl flex-col px-6 pt-32">
    <p class="font-mono text-sm text-ink-2">
      <span class="text-accent-text">$</span> open ./this-page
    </p>
    <h1 class="mt-4 font-display text-3xl font-semibold tracking-tight">
      error 404: no such file or directory
    </h1>
    <p class="mt-3 max-w-md text-base leading-relaxed text-ink-2">
      The page you're looking for moved, was renamed, or never existed.
    </p>
    <p class="mt-8">
      <a href="/" class="btn btn-primary">← Back home</a>
    </p>
  </main>
  <SiteFooter />
</Base>

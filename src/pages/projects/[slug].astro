---
import { getCollection, render } from 'astro:content';
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import Tag from '../../components/Tag.astro';
import ProjectCard from '../../components/ProjectCard.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const others = (await getCollection('projects'))
  .filter((p) => p.id !== project.id)
  .sort((a, b) => a.data.order - b.data.order);

const images = import.meta.glob<{ default: ImageMetadata }>('../../assets/projects/*.png', {
  eager: true,
});
const image = project.data.image
  ? images[`../../assets/projects/${project.data.image}`]?.default
  : null;
---

<Base title={`${project.data.title} · Adetayo Tella`} description={project.data.summary}>
  <SiteHeader />
  <main id="main" class="mx-auto w-full max-w-3xl px-6 pt-28 sm:pt-32">
    <nav class="font-mono text-xs text-ink-3" aria-label="Breadcrumb">
      <a href="/#projects" class="transition-colors duration-150 ease-out hover:text-ink">
        ~/projects
      </a>
      <span aria-hidden="true"> / </span>
      <span class="text-ink-2">{project.id}</span>
    </nav>

    <header class="mt-8">
      <h1 class="font-display text-3xl font-semibold tracking-tight sm:text-4xl">
        {project.data.title}
      </h1>
      {
        project.data.subtitle && (
          <p class="mt-2 font-mono text-xs text-ink-3" aria-hidden="true">
            {project.data.subtitle}
          </p>
        )
      }
      <p class="mt-5 text-base leading-relaxed text-ink-2">{project.data.summary}</p>
      <div class="mt-5 flex flex-wrap gap-1.5">
        {project.data.tags.map((tag) => <Tag label={tag} />)}
      </div>
      {
        image && (
          <Image
            src={image}
            alt={project.data.imageAlt || `Repository view of ${project.data.title}`}
            widths={[640, 960, 1280]}
            sizes="(min-width: 768px) 768px, 100vw"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            format="webp"
            quality={80}
            class="mt-8 h-auto w-full rounded-xl border border-line"
          />
        )
      }
      {
        project.data.links?.repo && (
          <a
            class="link mt-5 inline-block text-sm font-medium"
            href={project.data.links.repo}
            target="_blank"
            rel="noopener noreferrer"
          >
            View repository ↗
          </a>
        )
      }
    </header>

    <article class="case mt-12">
      <Content />
    </article>

    <nav class="mt-16" aria-label="More projects">
      <h2 class="font-display text-xl font-semibold tracking-tight">More projects</h2>
      <div data-reveal-group class="mt-6 grid gap-5 sm:grid-cols-2">
        {
          others.map((other, i) => (
            <ProjectCard
              project={other}
              index={i + 1}
              class={others.length % 2 === 1 && i === others.length - 1 ? 'sm:col-span-2' : ''}
            />
          ))
        }
      </div>
    </nav>
  </main>
  <SiteFooter />
</Base>

---
import { profile } from '../data/profile';
import TerminalCard from './TerminalCard.astro';
---

<!-- 100dvh hero: text left, terminal right, one accent word in the display headline.
     Gradient word = intentional: the terminal cursor motif carried into the type. -->
<section class="relative flex min-h-[100dvh] items-center overflow-hidden pt-20">
  <div
    class="bg-grid absolute inset-0 [mask-image:linear-gradient(to_bottom,black_55%,transparent)]"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto w-full max-w-5xl px-6 py-16">
    <div class="grid items-center gap-12 lg:grid-cols-[1.1fr_0.9fr]">
      <div>
        <p class="hero-load hl-1 font-mono text-xs text-ink-3 sm:text-sm">
          <span class="text-accent-text">$</span>
          {profile.name.toLowerCase()} · {profile.education.school}
        </p>
        <h1
          class="hero-load hl-2 mt-5 max-w-xl font-display text-4xl font-semibold leading-[1.08] tracking-tight sm:text-5xl lg:text-[3.4rem]"
        >
          I build <span class="text-accent">intelligent systems</span> and study how they
          work.
        </h1>
        <p class="hero-load hl-3 mt-6 max-w-md text-base leading-relaxed text-ink-2">
          {profile.support}
        </p>
        <div class="hero-load hl-4 mt-8 flex flex-wrap items-center gap-3">
          <a href="/#projects" class="btn btn-primary">View projects</a>
          <a
            href={profile.github}
            class="btn btn-secondary"
            target="_blank"
            rel="noopener noreferrer">GitHub ↗</a
          >
        </div>
      </div>
      <div class="hero-load hl-5">
        <TerminalCard />
      </div>
    </div>
  </div>
</section>

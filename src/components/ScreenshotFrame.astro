---
import { Image } from 'astro:assets';

/**
 * A screenshot framed as a small repo window: traffic-light dots + a mono URL bar,
 * matching the TerminalCard chrome so the two read as one family.
 */
interface Props {
  src: ImageMetadata;
  alt: string;
  url: string;
  eager?: boolean;
  class?: string;
}

const { src, alt, url, eager = false, class: className = '' } = Astro.props;
---

<figure class:list={['overflow-hidden rounded-lg border border-line bg-paper', className]}>
  <div class="flex items-center gap-2 border-b border-line px-4 py-2.5">
    <span class="size-2 rounded-full bg-line-strong" aria-hidden="true"></span>
    <span class="size-2 rounded-full bg-line-strong" aria-hidden="true"></span>
    <span class="size-2 rounded-full bg-accent/60" aria-hidden="true"></span>
    <span class="ml-2 truncate font-mono text-[10.5px] text-ink-3">{url}</span>
  </div>
  <Image
    src={src}
    alt={alt}
    widths={[640, 960, 1280]}
    sizes="(min-width: 768px) 33vw, 100vw"
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
    format="webp"
    quality={80}
    class="h-auto w-full"
  />
</figure>

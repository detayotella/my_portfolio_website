---
interface Props {
  index: string;
  title: string;
  note?: string;
}

const { index, title, note } = Astro.props;
---

<div data-reveal class="mb-10 flex items-baseline gap-4 border-t border-line pt-8">
  <span class="font-mono text-xs text-accent-text" aria-hidden="true">{index}</span>
  <h2 class="text-2xl font-semibold tracking-tight">{title}</h2>
  {
    note && (
      <span class="ml-auto hidden font-mono text-xs text-ink-3 sm:block" aria-hidden="true">
        {note}
      </span>
    )
  }
</div>

---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!-- plain-language section heading: no numbering, no floating meta note -->
<div data-reveal class="mb-10 border-t border-line pt-8">
  <h2 class="font-display text-2xl font-semibold tracking-tight sm:text-3xl">{title}</h2>
</div>

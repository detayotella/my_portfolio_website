---
import SectionHeading from './SectionHeading.astro';
import Tag from './Tag.astro';
import { skillGroups } from '../data/skills';
---

<section id="skills" class="mx-auto w-full max-w-5xl px-6 py-20">
  <SectionHeading index="03" title="Technical Skills" note="// ordered by relevance, not proficiency" />

  <div class="grid gap-x-12 gap-y-10 md:grid-cols-2">
    {
      skillGroups.map((group) => (
        <div data-reveal>
          <h3 class="font-mono text-[11px] uppercase tracking-[0.18em] text-ink-3">
            {group.label}
          </h3>
          <div class="mt-3.5 flex flex-wrap gap-1.5">
            {group.items.map((item) => (
              <Tag label={item} />
            ))}
          </div>
          {group.note && (
            <p class="mt-3 font-mono text-[11px] text-ink-3" aria-hidden="true">
              {'// '}
              {group.note}
            </p>
          )}
        </div>
      ))
    }
  </div>
</section>

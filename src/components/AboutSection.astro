---
import SectionHeading from './SectionHeading.astro';
import { profile } from '../data/profile';

const facts = [
  {
    term: 'education',
    value: profile.education.degree,
    sub: `${profile.education.school} · ${profile.education.period}`,
  },
  { term: 'focus', value: 'AI systems · ML · backend · computer vision' },
  { term: 'currently', value: 'building RAG apps & backend services' },
  { term: 'based in', value: profile.location },
];
---

<section id="about" class="mx-auto w-full max-w-5xl px-6 py-20">
  <SectionHeading title="About" />

  <div class="grid gap-12 lg:grid-cols-[1.5fr_1fr]">
    <div data-reveal class="space-y-5 text-base leading-relaxed text-ink-2">
      <p>
        I'm a Computer Science graduate from the {profile.education.school}, driven by a curiosity
        about how intelligent systems work, from the mathematical foundations of machine learning
        to the engineering behind real-world AI applications.
      </p>
      <p>
        My interests lie at the intersection of{' '}
        <strong class="font-medium text-ink">AI research, machine learning, and software
        engineering</strong>, particularly in Natural Language Processing (NLP), Computer Vision,
        Healthcare AI, and Medical Imaging. I'm fascinated by how models learn, process
        information, and interpret complex data, and by the research that pushes these
        capabilities forward.
      </p>
      <p>
        My work spans developing deep learning models in PyTorch, building LLM-powered
        applications and retrieval pipelines, and engineering backend systems. I enjoy moving
        beyond high-level abstractions to understand the underlying mechanisms, from
        backpropagation and attention to model architectures, optimization, and data pipelines.
      </p>
      <p>
        I'm interested in bridging the gap between research and engineering by investigating new
        ideas, experimenting with models, and building intelligent systems that are technically
        rigorous, reliable, and useful in solving real-world problems.
      </p>
    </div>

    <aside data-reveal style="--reveal-i: 1" class="h-fit border-l-2 border-line pl-6">
      <dl class="space-y-6">
        {
          facts.map((fact) => (
            <div>
              <dt class="font-mono text-[11px] uppercase tracking-[0.15em] text-ink-3">
                {fact.term}
              </dt>
              <dd class="mt-1 text-sm font-medium text-ink">{fact.value}</dd>
              {fact.sub && <dd class="mt-0.5 text-sm text-ink-2">{fact.sub}</dd>}
            </div>
          ))
        }
      </dl>
    </aside>
  </div>
</section>

---
import { profile } from '../data/profile';
---

<!-- the one closing CTA, on a dark ink panel: mailto is the only button-shaped
     action here; GitHub/LinkedIn are quiet text links -->
<section id="contact" class="mx-auto w-full max-w-5xl px-6 pb-24 pt-4">
  <div
    data-reveal
    class="rounded-xl bg-ink px-6 py-12 shadow-[var(--shadow-card)] sm:px-10 sm:py-14"
  >
    <h2 class="font-display text-3xl font-semibold tracking-tight text-paper sm:text-4xl">
      Have something in mind? Let's build it.
    </h2>
    <p class="mt-4 max-w-lg text-base leading-relaxed text-paper/70">
      Internships, research questions, stubborn bugs, or an idea that needs a backend: email is
      the fastest way to reach me, and I read everything.
    </p>

    <div class="mt-8 flex flex-wrap items-center gap-4">
      <a class="btn bg-paper text-ink hover:bg-accent hover:text-white dark:hover:bg-accent dark:hover:text-[#131110]" href={`mailto:${profile.email}`}>
        Email me
      </a>

      <span
        id="email-copy"
        class="group inline-flex min-h-11 cursor-pointer items-center gap-2 rounded-md border border-paper/20 px-3 py-2 font-mono text-xs text-paper/80 transition-colors duration-150 ease-out hover:border-paper/50 hover:text-paper active:scale-[0.98]"
        role="button"
        tabindex="0"
        data-email={profile.email}
        title="Copy email address"
      >
        <span data-copy-label>{profile.email}</span>
        <svg
          data-copy-icon
          class="size-3.5 opacity-60 transition-opacity duration-150 group-hover:opacity-100"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <rect x="9" y="9" width="13" height="13" rx="2"></rect>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
        </svg>
      </span>
    </div>

    <div class="mt-10 flex flex-wrap gap-x-6 gap-y-2 text-sm">
      <a
        href={profile.github}
        target="_blank"
        rel="noopener noreferrer"
        class="text-paper/60 underline decoration-paper/25 underline-offset-4 transition-colors duration-150 ease-out hover:text-paper"
      >
        GitHub ↗
      </a>
      <a
        href={profile.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="text-paper/60 underline decoration-paper/25 underline-offset-4 transition-colors duration-150 ease-out hover:text-paper"
      >
        LinkedIn ↗
      </a>
    </div>
  </div>
</section>

<script is:inline>
  // idempotent: re-called from Base's astro:page-load listener after navigations
  window.__initContact = function () {
    const copyBtn = document.getElementById('email-copy');
    if (!copyBtn) return; // not on a page with the contact section
    const label = copyBtn.querySelector('[data-copy-label]');
    if (!label) return;
    const icon = copyBtn.querySelector('[data-copy-icon]');

    const copy = async () => {
      const email = copyBtn.getAttribute('data-email') || '';
      let copied = false;
      try {
        await navigator.clipboard.writeText(email);
        copied = true;
      } catch {
        // clipboard API unavailable (permissions/insecure context): legacy fallback
        const ta = document.createElement('textarea');
        ta.value = email;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        // execCommand is deprecated, but it is the standard legacy fallback here
        try {
          copied = /** @type {any} */ (document).execCommand('copy');
        } catch {
          copied = false;
        }
        ta.remove();
      }
      if (!copied) {
        // last resort: hand off to the mail client
        window.location.href = `mailto:${email}`;
        return;
      }
      const original = label.textContent;
      label.textContent = 'copied to clipboard';
      icon?.classList.add('hidden');
      window.setTimeout(() => {
        label.textContent = original;
        icon?.classList.remove('hidden');
      }, 1600);
    };

    copyBtn.onclick = copy;
    copyBtn.onkeydown = (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        copy();
      }
    };
  };
</script>

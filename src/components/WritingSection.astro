---
import { getCollection } from 'astro:content';
import SectionHeading from './SectionHeading.astro';

const posts = (await getCollection('writing', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const dateFormat = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---

{
  posts.length > 0 && (
    <section id="writing" class="mx-auto w-full max-w-5xl px-6 py-20">
      <SectionHeading title="Writing" />

      <div data-reveal-group class="divide-y divide-line border-t border-line">
        {posts.map((post) => (
          <article data-reveal-child class="group relative grid gap-2 py-7 sm:grid-cols-[10rem_1fr] sm:gap-8">
            <p class="font-mono text-xs leading-6 text-ink-3">{dateFormat.format(post.data.pubDate)}</p>
            <div>
              <h3 class="font-display text-lg font-semibold tracking-tight">
                <a
                  href={`/writing/${post.id}/`}
                  class="transition-colors duration-150 ease-out after:absolute after:inset-0 group-hover:text-accent-text"
                >
                  {post.data.title}
                </a>
              </h3>
              <p class="mt-1.5 max-w-2xl text-sm leading-relaxed text-ink-2">{post.data.description}</p>
              {post.data.tags.length > 0 && (
                <p class="mt-2 font-mono text-[11px] text-ink-3">{post.data.tags.join(', ')}</p>
              )}
            </div>
          </article>
        ))}
      </div>

      <div class="mt-8 text-sm">
        <a href="/writing/" class="link font-medium">All writing <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </section>
  )
}

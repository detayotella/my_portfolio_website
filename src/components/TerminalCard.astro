---
const lines = [
  { cmd: 'whoami', out: 'adetayo tella · cs grad · ai/ml engineer' },
  { cmd: 'cat focus.txt', out: 'ai systems · ml · rag · computer vision · healthcare ai' },
  {
    cmd: 'ls ~/building',
    out: 'e-commerce-api  social-app-microservices  cifar-10  langchain-projects',
  },
  { cmd: 'uptime', out: 'building since 2021 · deep in transformers & computer vision' },
] as const;
---

<div class="lift overflow-hidden rounded-xl border border-line bg-surface">
  <div class="flex items-center gap-2 border-b border-line px-4 py-3">
    <span class="size-2.5 rounded-full bg-line-strong" aria-hidden="true"></span>
    <span class="size-2.5 rounded-full bg-line-strong" aria-hidden="true"></span>
    <span class="size-2.5 rounded-full bg-accent/60" aria-hidden="true"></span>
    <span class="ml-2 font-mono text-[11px] text-ink-3">adetayo@futminna: ~</span>
  </div>
  <div class="space-y-2.5 p-5 font-mono text-[13px] leading-relaxed">
    {
      lines.map((line, i) => (
        <div style={`--line-i: ${i}`}>
          <p>
            <span class="text-accent-text">$</span>{' '}
            <span
              class="term-cmd text-ink"
              style={`--cmd-w: ${line.cmd.length + 1}ch`}
              >{line.cmd}</span
            >
          </p>
          <p class="term-out text-ink-2">{line.out}</p>
        </div>
      ))
    }
    <p class="term-caret" style={`--line-count: ${lines.length}`}>
      <span class="text-accent-text">$</span>
      <span class="cursor-blink text-accent">▊</span>
    </p>
  </div>
</div>

<style>
  /*
   * Typewriter on first visit of the session (html.hero-first is set in Base).
   * Width animates in ch units with overflow hidden, so line height never
   * changes and there is no layout shift. Static without JS or on repeat visits.
   */
  @media (prefers-reduced-motion: no-preference) {
    :global(.hero-first) .term-cmd {
      display: inline-block;
      overflow: hidden;
      white-space: nowrap;
      vertical-align: bottom;
      width: 0;
      animation: term-type 0.5s steps(22, end) both;
      animation-delay: calc(var(--line-i) * 0.55s + 0.85s);
    }
    :global(.hero-first) .term-out {
      opacity: 0;
      animation: term-fade 0.35s ease-out both;
      animation-delay: calc(var(--line-i) * 0.55s + 1.3s);
    }
    :global(.hero-first) .term-caret {
      opacity: 0;
      animation: term-fade 0.3s ease-out both;
      animation-delay: calc(var(--line-count) * 0.55s + 1.1s);
    }
  }
  @keyframes term-type {
    from {
      width: 0;
    }
    to {
      width: var(--cmd-w);
    }
  }
  @keyframes term-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
</style>

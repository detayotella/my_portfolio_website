---
import ThemeToggle from './ThemeToggle.astro';
import { nav } from '../data/profile';
---

<header class="sticky top-0 z-40 border-b border-line bg-paper/85 backdrop-blur">
  <div class="mx-auto flex h-16 w-full max-w-5xl items-center justify-between px-6">
    <a href="/" class="font-mono text-sm font-semibold tracking-tight text-ink">
      adetayo<span class="text-accent-text">.</span>tella<span class="cursor-blink text-accent">_</span>
    </a>

    <nav class="hidden items-center gap-7 md:flex" aria-label="Primary">
      {
        nav.map((item) => (
          <a href={item.href} class="text-sm text-ink-2 transition-colors hover:text-ink">
            {item.label}
          </a>
        ))
      }
      <ThemeToggle />
    </nav>

    <div class="flex items-center gap-3 md:hidden">
      <ThemeToggle />
      <button
        id="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Open menu"
        class="grid size-9 place-items-center rounded-[3px] border border-line text-ink-2 transition-colors hover:border-line-strong hover:text-ink"
      >
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-nav" hidden class="border-t border-line bg-paper md:hidden">
    <nav class="mx-auto flex w-full max-w-5xl flex-col px-6 py-2" aria-label="Mobile">
      {
        nav.map((item) => (
          <a href={item.href} class="border-b border-line py-3.5 text-sm text-ink-2 last:border-b-0">
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('menu-toggle');
  const panel = document.getElementById('mobile-nav');

  btn?.addEventListener('click', () => {
    const willOpen = panel?.hasAttribute('hidden') ?? false;
    panel?.toggleAttribute('hidden', !willOpen);
    btn.setAttribute('aria-expanded', String(willOpen));
    btn.setAttribute('aria-label', willOpen ? 'Close menu' : 'Open menu');
  });

  panel?.querySelectorAll('a').forEach((link) =>
    link.addEventListener('click', () => {
      panel.setAttribute('hidden', '');
      btn?.setAttribute('aria-expanded', 'false');
      btn?.setAttribute('aria-label', 'Open menu');
    })
  );
</script>

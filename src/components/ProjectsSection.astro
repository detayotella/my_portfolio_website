---
import { getCollection } from 'astro:content';
import SectionHeading from './SectionHeading.astro';
import ProjectCard from './ProjectCard.astro';
import SchematicSVG from './SchematicSVG.astro';
import Tag from './Tag.astro';

const entries = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = entries.find((e) => e.data.featured);
const rest = entries.filter((e) => e.data.featured !== true);
---

<section id="projects" class="mx-auto w-full max-w-5xl px-6 py-20">
  <SectionHeading index="02" title="Projects" note="// what I've built" />

  {
    featured && (
      <article
        data-reveal
        class="grid gap-10 rounded-md border border-line bg-surface p-6 sm:p-8 lg:grid-cols-[1fr_0.95fr]"
      >
        <div class="flex flex-col">
          <p class="font-mono text-[11px] uppercase tracking-[0.15em] text-accent-text">
            ★ featured project
          </p>
          <h3 class="mt-3 text-2xl font-semibold tracking-tight">
            <a
              href={`/projects/${featured.id}/`}
              class="transition-colors hover:text-accent-text"
            >
              {featured.data.title}
            </a>
          </h3>
          <p class="mt-1 font-mono text-xs text-ink-3" aria-hidden="true">
            {featured.data.subtitle}
          </p>
          <p class="mt-4 text-sm leading-relaxed text-ink-2">{featured.data.summary}</p>

          <div class="mt-7 space-y-2.5 rounded-md border border-line bg-paper p-4 font-mono text-xs leading-relaxed text-ink-2">
            <p class="text-ink-3">// inside the repo</p>
            <p>
              <span class="text-accent-text">→</span> five rag variants: basic · citations ·
              memory · multi-document · sqlite-persistent
            </p>
            <p>
              <span class="text-accent-text">→</span> llm-as-judge loop: structured scoring,
              hallucination flags, regeneration
            </p>
            <p>
              <span class="text-accent-text">→</span> interactive blog generator with conversation
              history
            </p>
          </div>

          <div class="mt-6 flex flex-wrap gap-1.5">
            {featured.data.tags.map((tag) => <Tag label={tag} />)}
          </div>

          <div class="mt-auto flex flex-wrap items-center gap-5 pt-7 text-sm">
            <a href={`/projects/${featured.id}/`} class="link font-medium">
              Read the case study →
            </a>
            {
              featured.data.links?.repo && (
                <a
                  href={featured.data.links.repo}
                  class="text-ink-2 underline decoration-line-strong underline-offset-4 transition-colors hover:text-accent-text"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Repository ↗
                </a>
              )
            }
          </div>
        </div>

        <div class="flex flex-col justify-center">
          <SchematicSVG variant="rag" />
          <p class="mt-3 font-mono text-[11px] leading-relaxed text-ink-3" aria-hidden="true">
            // fig 01 - the rag pipeline: ingestion at index time, retrieval and grounded
            generation at query time
          </p>
        </div>
      </article>
    )
  }

  <div class="mt-6 grid gap-5 md:grid-cols-3">
    {rest.map((project) => <ProjectCard project={project} />)}
  </div>
</section>

---
import SectionHeading from './SectionHeading.astro';
import Tag from './Tag.astro';
import { certifications, education, experience } from '../data/experience';
---

<section id="experience" class="mx-auto w-full max-w-5xl px-6 py-20">
  <SectionHeading index="05" title="Experience" note="// work · education · certifications" />

  <div class="grid gap-12 lg:grid-cols-[1.45fr_1fr]">
    <div>
      {
        experience.map((job) => (
          <article data-reveal class="relative border-l border-line pb-12 pl-6">
            <span
              class="absolute top-1.5 -left-[5px] size-2 rounded-full bg-accent"
              aria-hidden="true"
            />
            <p class="font-mono text-[11px] text-ink-3">{job.period}</p>
            <h3 class="mt-1 text-lg font-semibold tracking-tight">
              {job.role} <span class="font-normal text-ink-2">· {job.org}</span>
            </h3>
            <p class="font-mono text-[11px] text-ink-3">{job.location}</p>
            <ul class="mt-3 space-y-1.5 text-sm leading-relaxed text-ink-2">
              {job.points.map((point) => (
                <li class="relative pl-4 before:absolute before:left-0 before:font-bold before:text-accent-text before:content-['·']">
                  {point}
                </li>
              ))}
            </ul>
            <div class="mt-4 flex flex-wrap gap-1.5">
              {job.tags.map((tag) => (
                <Tag label={tag} />
              ))}
            </div>
          </article>
        ))
      }

      <article data-reveal class="relative border-l border-line pl-6">
        <span class="absolute top-1.5 -left-[5px] size-2 rounded-full bg-accent" aria-hidden="true" />
        <p class="font-mono text-[11px] text-ink-3">{education.period}</p>
        <h3 class="mt-1 text-lg font-semibold tracking-tight">{education.degree}</h3>
        <p class="text-sm text-ink-2">{education.school}</p>
        <p class="mt-2 max-w-md text-sm leading-relaxed text-ink-2">{education.note}</p>
      </article>
    </div>

    <aside data-reveal class="h-fit">
      <h3 class="font-mono text-[11px] uppercase tracking-[0.18em] text-ink-3">certifications</h3>
      <ul class="mt-3 divide-y divide-line border-y border-line">
        {
          certifications.map((cert) => (
            <li class="flex items-baseline justify-between gap-4 py-3.5">
              <div>
                <p class="text-sm font-medium text-ink">{cert.title}</p>
                <p class="mt-0.5 font-mono text-[11px] text-ink-3">{cert.org}</p>
              </div>
              <span class="font-mono text-xs text-ink-3">{cert.year}</span>
            </li>
          ))
        }
      </ul>
      <p class="mt-3 font-mono text-[11px] leading-relaxed text-ink-3" aria-hidden="true">
        // supporting signal · the projects above carry the weight
      </p>
    </aside>
  </div>
</section>

---
import type { CollectionEntry } from 'astro:content';
import Tag from './Tag.astro';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
---

<article
  data-reveal
  class="group flex flex-col rounded-md border border-line bg-surface p-6 transition-colors hover:border-line-strong"
>
  <p class="font-mono text-[11px] text-ink-3" aria-hidden="true">
    p.{String(project.data.order).padStart(2, '0')}
  </p>
  <h3 class="mt-2 text-lg font-semibold tracking-tight">
    <a
      href={`/projects/${project.id}/`}
      class="transition-colors after:absolute after:inset-0 group-hover:text-accent-text"
    >
      {project.data.title}
    </a>
  </h3>
  {
    project.data.subtitle && (
      <p class="mt-0.5 font-mono text-[11px] text-ink-3" aria-hidden="true">
        {project.data.subtitle}
      </p>
    )
  }
  <p class="mt-3 text-sm leading-relaxed text-ink-2">
    {project.data.summary}
  </p>
  <div class="mt-4 flex flex-wrap gap-1.5">
    {project.data.tags.map((tag) => <Tag label={tag} />)}
  </div>
  <div class="mt-auto pt-5 text-sm">
    <a
      href={`/projects/${project.id}/`}
      class="link font-medium"
      aria-label={`Read the ${project.data.title} case study`}
    >
      Case study →
    </a>
  </div>
</article>
